rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isSuperadmin() {
      return signedIn()
        && get(/databases/$(database)/documents/userProfiles/$(request.auth.uid)).data.role == 'superadmin'
        && get(/databases/$(database)/documents/userProfiles/$(request.auth.uid)).data.active == true;
    }

    function requesterProfile() {
      return get(/databases/$(database)/documents/userProfiles/$(request.auth.uid)).data;
    }

    function sameInstitution(institutionKey) {
      return signedIn() && requesterProfile().institutionKey == institutionKey;
    }

    function isInstitutionalRecord(data) {
      return data.reportType != 'public_denuncia';
    }

    match /userProfiles/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isSuperadmin());
      allow create, update, delete: if false;
    }

    match /records/{docId} {
      allow read: if isInstitutionalRecord(resource.data);

      allow create: if isInstitutionalRecord(request.resource.data);

      allow update, delete: if isSuperadmin() && isInstitutionalRecord(resource.data);
    }
  }
}